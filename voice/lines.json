  },
  {
   "n": 273,
   "say": "نبص على الشكل المنقّط",
   "key": "نبص على الشكل المنقّط"
  },
  {
   "n": 274,
   "say": "دودة على الزرع! نلمسها",
   "key": "دودة على الزرع! نلمسها"
  },
  {
   "n": 275,
   "say": "نلاقي كل اتنين شبه بعض",
   "key": "نلاقي كل اتنين شبه بعض"
  },
  {
   "n": 276,
   "say": "نبص على الصورة الصغيرة",
