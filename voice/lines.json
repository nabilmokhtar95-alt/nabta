  },
  {
   "n": 279,
   "say": "الأرقام بتبان بالترتيب",
   "key": "الأرقام بتبان بالترتيب"
  },
  {
   "n": 280,
   "say": "نختار أول حرف في الاسم",
   "key": "نختار أول حرف في الاسم"
  },
  {
   "n": 281,
   "say": "ندوّر على الحرف المكتوب",
   "key": "ندوّر على الحرف المكتوب"
  },
  {
   "n": 282,
   "say": "نلمسه في الصورة التانية",
   "key": "نلمسه في الصورة التانية"
  },
  {
   "n": 283,
   "say": "نسحب خط لحد ضله أو أكله",
